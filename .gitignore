# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Node
node_modules/
npm-debug.log*
package-lock.json

# Virtual environments
venv/
env/
.venv/

# Flask / App runtime
instance/
.webassets-cache

# Generated session output files
/sessions/
/uploads/
/previews/
static/sessions/

# Allow static uploads & previews (templates and overlays)
!static/uploads/
!static/uploads/**
!static/previews/
!static/previews/**

# Imported music files (exclude music from YouTube / Spotify / custom uploads)
audio/yt_*.mp3
audio/music_library/
audio/music.mp3
audio/temp_*.mp3
audio/temp_yt_*.mp3
static/audio/music.mp3
scratch_audio/

# Binaries / FFmpeg
bin/

# Database / data files (never commit session data or databases)
*.db
*.sqlite
*.sqlite3
music_library.db
database/*.db

# Logs & Scratch files
*.log
*.txt
scratch/
scratch_*
mobile-view.html

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.*
config.local.py

# Temp
*.tmp
*.bak
